{
    "name": "bracket-jumper",
    "displayName": "Bracket Jumper",
    "description": "Bracket-based editor navigation and text selection",
    "version": "1.1.8",
    "publisher": "sashaweiss",
    "license": "MIT",
    "engines": {
        "vscode": "^1.10.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:bracket-jumper.jumpLeft",
        "onCommand:bracket-jumper.jumpRight",
        "onCommand:bracket-jumper.selectLeft",
        "onCommand:bracket-jumper.selectRight",
        "onCommand:bracket-jumper.ascendLeft",
        "onCommand:bracket-jumper.ascendRight",
        "onCommand:bracket-jumper.selectAscendLeft",
        "onCommand:bracket-jumper.selectAscendRight"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "bracket-jumper.jumpLeft",
                "title": "Jump to next-left bracket"
            },
            {
                "command": "bracket-jumper.jumpRight",
                "title": "Jump to next-right bracket"
            },
            {
                "command": "bracket-jumper.selectLeft",
                "title": "Select to next-left bracket"
            },
            {
                "command": "bracket-jumper.selectRight",
                "title": "Select to next-right bracket"
            },
            {
                "command": "bracket-jumper.ascendLeft",
                "title": "Jump to nearest left bracket at same or higher scope"
            },
            {
                "command": "bracket-jumper.selectAscendLeft",
                "title": "Select to the nearest left bracket at the same or higher scope"
            },
            {
                "command": "bracket-jumper.ascendRight",
                "title": "Jump to the nearest right bracket at the same or higher scope"
            },
            {
                "command": "bracket-jumper.selectAscendRight",
                "title": "Select to the nearest right bracket at the same of higher scope"
            }
        ],
        "keybindings": [
            {
                "command": "bracket-jumper.jumpLeft",
                "key": "ctrl+alt+left",
                "mac": "ctrl+left",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-jumper.jumpRight",
                "key": "ctrl+alt+right",
                "mac": "ctrl+right",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-jumper.selectLeft",
                "key": "ctrl+alt+shift+left",
                "mac": "ctrl+shift+left",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-jumper.selectRight",
                "key": "ctrl+alt+shift+right",
                "mac": "ctrl+shift+right",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-jumper.ascendLeft",
                "key": "ctrl+alt+up",
                "mac": "ctrl+up",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-jumper.selectAscendLeft",
                "key": "ctrl+alt+shift+up",
                "mac": "ctrl+shift+up",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-jumper.ascendRight",
                "key": "ctrl+alt+down",
                "mac": "ctrl+down",
                "when": "editorTextFocus"
            },
            {
                "command": "bracket-jumper.selectAscendRight",
                "key": "ctrl+alt+shift+down",
                "mac": "ctrl+shift+down",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "Bracket Jumper configuration",
            "properties": {
                "bracket-jumper.openingBrackets": {
                    "type": "array",
                    "default": [
                        "{",
                        "[",
                        "("
                    ],
                    "description": "Characters to be recognized as opening brackets. MUST have a pair in closingBrackets at the same position."
                },
                "bracket-jumper.closingBrackets": {
                    "type": "array",
                    "default": [
                        "}",
                        "]",
                        ")"
                    ],
                    "description": "Characters to be recognized as closing brackets. MUST have a pair in openingBrackets at the same position."
                }
                ,
                "bracket-jumper.landInside": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, the cursor will land inside the bracket instead of outside of it"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "tsc -p ./",
        "watch": "tsc -w -p ./",
        "test": "node ./test/runTest.js"
    },
    "devDependencies": {
        "typescript": "^4.9.5",
        "@types/vscode": "^1.74.0",
        "@vscode/test-electron": "^2.4.0",
        "mocha": "^9.0.0",
        "@types/node": "^18.0.0",
        "@types/mocha": "^9.0.0"
    },
    "bugs": {
        "url": "https://github.com/sashaweiss/vscode-bracket-jumper/issues"
    },
    "homepage": "https://github.com/sashaweiss/vscode-bracket-jumper/blob/master/README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/sashaweiss/vscode-bracket-jumper"
    }
}
